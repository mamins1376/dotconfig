#!/bin/sh

if [ "$(id -u)" -eq 0 ]
then _doas=
elif hash doas 2>/dev/null
then _doas=doas
else _doas=sudo
fi

ID="$(. /etc/os-release && echo $ID)"

case "$ID" in
  arch)
    if hash paru 2>/dev/null
    then
      yes | paru
      yes | paru -Scc
    else
      $_doas sh -c 'yes | pacman -Suy'
      $_doas sh -c 'yes | pacman -Scc'
    fi
    ;;
  debian)
    $_doas apt-get update
    $_doas apt-get upgrade --assume-yes
    ;;
  void)
    $_doas xbps-install -Suy
    xlocate -S
    ;;
  *)
    echo "WARN: unknown distribution: $ID" 1>&2
    ;;
esac

rustup update
